# LOCAL DEVELOPMENT ENVIRONMENT
# Copy this to .env.local and fill in your local values

# Environment identifier (local, staging, prod)
APP_ENV=local

# Google Places API Key for Locations
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Local PostgreSQL Database (for Prisma - from local Supabase)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Local Backend URL
EXPO_PUBLIC_TRPC_URL=http://localhost:3001/trpc

# Local Supabase HTTP APIs (for auth/storage)
SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Google Play Service Account (for receipt verification)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Apple receipt verification
APPLE_APP_ID=1234
APPLE_ROOT_CA_PATHS=./backend/certs/AppleRootCA-G2.cer,./backend/certs/AppleRootCA-G3.cer


# Meta / Facebook SDK (for ad conversion tracking)
FACEBOOK_APP_ID=1311420627600982
FACEBOOK_CLIENT_TOKEN=496957a938ebd2f4e938534dd51cdb9d
