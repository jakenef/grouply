# STAGING ENVIRONMENT
# Copy this to .env.staging and fill in your staging values

# Google Places API Key for Locations
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# Staging Database (e.g., Supabase staging instance)
DATABASE_URL="your-staging-database-url-with-pooling"
DIRECT_URL="your-staging-database-direct-url"

# Staging Backend URL (e.g., Render deployment)
EXPO_PUBLIC_TRPC_URL=https://your-staging-backend.com/trpc

# Supabase (staging)
SUPABASE_URL=your-staging-supabase-url
EXPO_PUBLIC_SUPABASE_URL=your-staging-supabase-url
EXPO_PUBLIC_SUPABASE_KEY=your-staging-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key

