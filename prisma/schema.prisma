// =======================
// Prisma Schema
// =======================

// ---------- Generator & Datasource ----------
generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------
enum UserRole {
  USER
  ADMIN
}

enum LocationPrecision {
  CITY
  POINT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// =======================
// Models
// =======================

// ---------- Core ----------
model User {
  // Identity
  id         String   @id @default(uuid())
  authUserId String   @unique
  role       UserRole @default(USER)
  email      String   @unique

  // Personal Info
  givenName  String // first name
  familyName String? // last name
  avatarUrl  String?
  birthday   DateTime?
  gender     Gender?
  bio        String?

  // Preferences
  minGroupSize     Int?
  maxGroupSize     Int?
  maxTravelKm      Int?
  minAgePreference Int?
  maxAgePreference Int?

  // Location
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Timestamps
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organizedEvents Event[]             @relation("EventOrganizer")
  traitScores     UserTraitScore[]
  interests       UserInterest[]
  registrations   EventRegistration[]
  chatMemberships ChatMember[]
  chatMessages    ChatMessage[]

  @@index([locationId])
}

// ---------- Location ----------
model Location {
  id          String            @id @default(uuid())
  // City-level (for users)
  city        String?
  region      String?
  countryCode String?
  // Point/venue (for events)
  formatted   String? // full address / place line
  lat         Float?
  lng         Float?
  precision   LocationPrecision
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  users  User[]
  events Event[]

  @@index([precision])
  @@index([lat, lng])
}

// ---------- Traits ----------
model Trait {
  id         String   @id @default(uuid())
  slug       String   @unique // e.g. "introversion", "risk-tolerance"
  label      String // human-readable name
  desc       String? // optional: explain to users/admins
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  UserTraitScore UserTraitScore[]
}

model UserTraitScore {
  userId    String
  traitId   String
  score     Float // e.g. 0..1 scale or -1..1 scale
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id])

  @@id([userId, traitId])
  @@index([traitId])
}

// ---------- Interests ----------
model Interest {
  id         String  @id @default(uuid())
  slug       String  @unique // "hiking"
  label      String
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  weight     Float    @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
  @@index([interestId])
}

// ---------- Activities ----------
model Activity {
  id          String                       @id @default(uuid())
  slug        String                       @unique // canonical id: "pickup-basketball"
  label       String
  description String?
  embedding   Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

// ---------- Events & Snapshot ----------
model Event {
  id            String   @id @default(uuid())
  name          String
  desc          String?
  startsAt      DateTime
  endsAt        DateTime
  isCancelled   Boolean  @default(false)
  maxAgeLimit   Int?
  minAgeLimit   Int?
  imageUrls     String[]
  coverImageUrl String

  // Organizer
  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])

  // Primary activity
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  // Precise venue
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Attendees
  maxAttendees  Int
  minAttendees  Int
  isFull        Boolean             @default(false)
  registrations EventRegistration[]

  // Chat (one channel per event)
  chatChannel ChatChannel? @relation("EventChannel")

  // Host vibe snapshot (1:1)
  snapshot EventProfileSnapshot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
  @@index([startsAt])
  @@index([locationId])
  @@index([isCancelled, startsAt])
}

model EventProfileSnapshot {
  // one-to-one with Event
  eventId String @id
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // who we captured from (duplicate for audit even if organizer changes)
  hostUserId    String
  hostGivenName String

  // matchable signals (keep flexible)
  interestIds String[] // e.g., top N of host's interests at creation
  traitScores Json? // { "introversion": 0.7, "risk-tolerance": 0.3, ... }

  // metadata
  capturedAt DateTime @default(now())

  @@index([capturedAt])
}

// ---------- Participation & Saves ----------
model EventRegistration {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

// ---------- Chat ----------
model ChatChannel {
  id        String   @id @default(uuid())
  kind      String // "event" / "ai"
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 event ↔ channel
  eventId String? @unique
  event   Event?  @relation("EventChannel", fields: [eventId], references: [id])

  messages ChatMessage[]
  members  ChatMember[]
}

model ChatMember {
  channelId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@id([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String          @id @default(uuid())
  role      ChatMessageRole @default(USER)
  channelId String
  authorId  String
  body      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?

  // Optional: tool call/result for LLM integrations
  toolName   String?
  toolArgs   Json?
  toolResult Json?

  channel ChatChannel @relation(fields: [channelId], references: [id])
  author  User        @relation(fields: [authorId], references: [id])

  @@index([channelId, createdAt])
}
