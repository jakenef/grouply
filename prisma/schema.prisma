// =======================
// Prisma Schema
// =======================

// ---------- Generator & Datasource ----------
generator client {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------
enum UserRole {
  USER
  ADMIN
}

enum LocationPrecision {
  city
  point
}

enum Gender {
  Male
  Female
  Other
}

enum ChatMessageRole {
  user
  assistant
  system
  tool
}

// =======================
// Models
// =======================

// ---------- Core ----------
model User {
  id          String   @id @default(uuid())
  authUserId  String   @unique // from your auth provider
  role        UserRole @default(USER)
  email       String   @unique
  displayName String
  avatarUrl   String?
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Coarse location (optional)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // 1:1 profile with matchable attributes
  profile UserProfile?

  // Relations
  organizedEvents Event[]             @relation("EventOrganizer")
  traitScores     UserTraitScore[]
  interests       UserInterest[]
  registrations   EventRegistration[]
  chatMemberships ChatMember[]
  chatMessages    ChatMessage[]
  savedEvents     SavedEvent[]

  @@index([locationId])
}

model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])

  // PII & demographics (optional)
  birthday DateTime?
  gender   Gender?
  bio      String?

  // Preferences that guide matching/search
  preferredGroupSizeMin Int?
  preferredGroupSizeMax Int?
  maxTravelKm           Int? // radius filter
  minAgePref            Int?
  maxAgePref            Int?

  // Future-proofing for semantic matching (MVP can ignore)
  embedding Json?

  updatedAt DateTime @updatedAt
}

// ---------- Location ----------
model Location {
  id          String            @id @default(uuid())
  // City-level (for users)
  city        String?
  region      String?
  countryCode String?
  // Point/venue (for events)
  formatted   String? // full address / place line
  lat         Float?
  lng         Float?
  precision   LocationPrecision
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  users  User[]
  events Event[]

  @@index([precision])
  @@index([lat, lng])
}

// ---------- Traits (extensible personality dims) ----------
model Trait {
  id         String   @id @default(uuid())
  slug       String   @unique // e.g. "introversion", "risk-tolerance"
  label      String // human-readable name
  desc       String? // optional: explain to users/admins
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  UserTraitScore UserTraitScore[]
}

model UserTraitScore {
  userId  String
  traitId String
  score   Float // e.g. 0..1 scale or -1..1 scale

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id])

  @@id([userId, traitId])
  @@index([traitId])
}

// ---------- Interests (user-side preferences) ----------
model Interest {
  id         String   @id @default(uuid())
  slug       String   @unique // "hiking"
  label      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isApproved Boolean  @default(false)

  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  weight     Float  @default(1)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
  @@index([interestId])
}

// ---------- Activities (supply taxonomy) ----------
model Activity {
  id    String @id @default(uuid())
  slug  String @unique // canonical id: "pickup-basketball"
  label String
  description String?
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

// ---------- Events & Snapshot ----------
model Event {
  id            String   @id @default(uuid())
  name          String
  desc          String?
  startsAt      DateTime
  endsAt        DateTime
  isCancelled   Boolean  @default(false)
  upperAgeLimit Int?
  lowerAgeLimit Int?
  eventUrl      String
  imageUrls     String[]

  // Organizer
  organizerId String
  organizer   User   @relation("EventOrganizer", fields: [organizerId], references: [id])

  // Primary activity
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  // Precise venue
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Attendees
  maxAttendees Int?
  isFull       Boolean             @default(false)
  regs         EventRegistration[]
  savedByUsers SavedEvent[]

  // Tags
  tags EventTagOnEvent[]

  // Chat (one channel per event)
  chatChannel ChatChannel? @relation("EventChannel")

  // Host vibe snapshot (1:1)
  snapshot EventProfileSnapshot?

  createdAt DateTime @default(now())

  @@index([activityId])
  @@index([startsAt])
  @@index([locationId])
  @@index([isCancelled, startsAt])
}

model EventProfileSnapshot {
  // one-to-one with Event
  eventId String @id
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // who we captured from (duplicate for audit even if organizer changes)
  hostUserId      String
  hostDisplayName String?

  // matchable signals (keep flexible)
  interestIds String[] // e.g., top N of host's interests at creation
  traitScores Json? // { "introversion": 0.7, "risk-tolerance": 0.3, ... }
  embedding   Json? // optional: future vector (store as JSON for MVP)

  // handy constraints copied for ranking/explanations
  lowerAgeLimit Int?
  upperAgeLimit Int?

  // metadata
  capturedAt DateTime @default(now())

  @@index([capturedAt])
}

// ---------- Event Tags (nuance & facets) ----------
model EventTag {
  id    String @id @default(uuid())
  slug  String @unique // "beginner", "sunrise", "dog-friendly", "free", "indoors"
  label String

  events EventTagOnEvent[]
}

model EventTagOnEvent {
  eventId String
  tagId   String

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tag   EventTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([eventId, tagId])
  @@index([tagId])
}

// ---------- Participation & Saves ----------
model EventRegistration {
  userId     String
  eventId    String
  createdAt  DateTime  @default(now())
  canceledAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
  @@index([eventId])
}

model SavedEvent {
  userId  String
  eventId String
  savedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ---------- Chat (lean) ----------
model ChatChannel {
  id        String   @id @default(uuid())
  kind      String // "event" for now
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 event ↔ channel
  eventId String? @unique
  event   Event?  @relation("EventChannel", fields: [eventId], references: [id])

  messages ChatMessage[]
  members  ChatMember[]
}

model ChatMember {
  channelId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@id([channelId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String          @id @default(uuid())
  role      ChatMessageRole @default(user)
  channelId String
  authorId  String
  body      String
  createdAt DateTime        @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  // Optional: tool call/result for LLM integrations
  toolName   String?
  toolArgs   Json?
  toolResult Json?

  channel ChatChannel @relation(fields: [channelId], references: [id])
  author  User        @relation(fields: [authorId], references: [id])

  @@index([channelId, createdAt])
}
