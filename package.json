{
  "name": "grouply",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "cp .env.dev .env && APP_VARIANT=development expo start --clear",
    "start:staging": "cp .env.stg .env && APP_VARIANT=staging expo start --clear",
    "expo-lint": "expo lint",
    "server-lint": "npx tsc --project tsconfig.server.json --noEmit",
    "dev:server": "cp .env.dev .env && nodemon --exec tsx backend/server/index.ts",
    "dev:server:staging": "cp .env.stg .env && nodemon --exec tsx backend/server/index.ts",
    "build:server": "tsc backend/server/index.ts --outDir dist",
    "test": "jest",
    "test:prod-build": "npm run build:server:prod && node dist/backend/server/index.js",
    "start:server:prod": "node dist/backend/server/index.js",
    "build:server:prod": "npx prisma generate && npx prisma migrate deploy && npx tsc --project tsconfig.server.json && cpy 'backend/generated/**' dist/backend/generated",
    "migrate:staging": "cp .env.stg .env && npx prisma migrate deploy",
    "migrate:dev": "cp .env.dev .env && npx prisma migrate dev",
    "deploy:internal": "APP_VARIANT=staging eas update --channel preview --platform ios",
    "update:production": "APP_VARIANT=production eas update --channel production --platform ios && APP_VARIANT=production eas update --channel production --platform android",
    "lint": "expo lint",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "eas:build:ios": "eas build -p ios",
    "eas:build:android": "eas build -p android",
    "eas:submit:ios": "eas submit -p ios",
    "eas:submit:android": "eas submit -p android"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.0.0",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5",
    "@prisma/client": "^6.16.2",
    "@ptomasroos/react-native-multi-slider": "^2.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/date-fns": "^2.5.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-checkbox": "~5.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.8",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "leo-profanity": "^1.9.0",
    "module-alias": "^2.2.3",
    "moti": "^0.30.0",
    "nativewind": "^4.2.0",
    "openai": "^6.8.1",
    "posthog-react-native": "^4.39.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-date-picker": "^5.0.13",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^14.7.17",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-otp-entry": "^1.8.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "baseline-browser-mapping": "^2.9.18",
    "cpy-cli": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true,
  "_moduleAliases": {
    "@": "dist"
  }
}
